# Banco de dados
# Local (docker): usa POSTGRES_PASSWORD abaixo.
# Cloud (Supabase): defina DATABASE_URL com a string do Session Pooler (porta 5432).
POSTGRES_PASSWORD=procurement-secret-2024
# DATABASE_URL=postgresql://usuario:senha@host.pooler.supabase.com:5432/postgres

# JWT
SECRET_KEY=procurement-jwt-secret-mude-em-producao

# Agendador interno. false em cloud (syncs via cron externo). true em docker local.
ENABLE_SCHEDULER=false

# Segredo do cron externo (header X-Cron-Secret nos endpoints /api/sync).
CRON_SECRET=

# Origens liberadas no CORS. "*" libera geral. Em prod, use a URL do front.
CORS_ORIGINS=*

# Schema do Postgres onde ficam as tabelas do robo. Isola de outros apps no mesmo
# banco. "public" = padrao. Neste deploy usamos "licita".
DB_SCHEMA=public

# IA — Assistente Sonar via Groq (crie em console.groq.com). Vazio = IA desligada.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SSO (deve ser igual ao Office)
SSO_KEY=acra-sso-2024

# URLs internas
OFFICE_API_URL=http://acra-backend:8000
HERMES_URL=http://hermes:4000
LITELLM_MASTER_KEY=Dfc@1947

# Token do sistema para chamadas internas do Hermes (gere via /api/auth/login)
PROC_API_TOKEN=

# Email (opcional — para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@acrasystem.com

# Frontend
FRONTEND_URL=http://localhost:3003

# Intervalo de sync em horas (padrão: 6)
PNCP_SYNC_INTERVAL_HOURS=6
